#!/bin/bash
# Locate the Motif folder relative to this bundle and open Setup.
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"

# /usr/bin/python3 on a current Mac is a stub that only offers to
# install developer tools, so each candidate is asked to actually run
# before it is trusted.
for PY in /opt/homebrew/bin/python3 /usr/local/bin/python3 \
         /Library/Frameworks/Python.framework/Versions/Current/bin/python3 \
         python3; do
  if command -v "$PY" >/dev/null 2>&1 && \
     "$PY" -c "import sys" >/dev/null 2>&1; then
    exec "$PY" "$HERE/setup/motif_setup.py" "$@"
  fi
done

osascript -e 'display alert "One more step" message "Motif needs a free component this Mac does not have yet. Choose Get it to download it, then open Motif Setup again." buttons {"Not now", "Get it"} default button "Get it"' \
  | grep -q "Get it" && open "https://www.python.org/downloads/macos/"
